<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <gradient android:type="linear" android:angle="115"
                android:startColor="#00FFFFFF" android:centerColor="#26FFFFFF"
                android:centerX="0.35" android:endColor="#00FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1.2dp" android:color="@color/glass_panel_border"/>
        </shape>
    </item>
</layer-list>
