<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14000000"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#30FFFFFF"/>
            <corners android:radius="25dp"/>
            <stroke android:width="1.3dp" android:color="#66FFFFFF"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#1AA0B8D8"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
