<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_row_selected"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_row_fill"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="@color/glass_row_border"/>
        </shape>
    </item>
</selector>
