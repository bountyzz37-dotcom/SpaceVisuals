<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mod_menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="#66000000">

    <!-- Main floating panel – sized closer to Atlas Client proportions -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mod_menu_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="40dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="72dp"
        app:cardBackgroundColor="#F01C1C1E"
        app:cardCornerRadius="18dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Left vertical icon bar -->
            <LinearLayout
                android:id="@+id/left_nav_bar"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:background="#1A000000"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <ImageButton
                    android:id="@+id/nav_home"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_nav_icon_selected"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_modules"
                    android:tint="#FFFFFF"
                    android:contentDescription="Home" />

                <ImageButton
                    android:id="@+id/nav_settings"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginBottom="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_settings"
                    android:tint="#A8B0B8"
                    android:contentDescription="Settings" />

                <ImageButton
                    android:id="@+id/nav_profile"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginBottom="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_edit"
                    android:tint="#A8B0B8"
                    android:contentDescription="Profile" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/nav_close"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#A8B0B8"
                    android:contentDescription="Close" />

            </LinearLayout>

            <!-- Main content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <!-- Top bar: Tabs + Search -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <!-- Tabs scroll -->
                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:id="@+id/tab_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tab_quick_access"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_selected"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="QUICK ACCESS"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tab_visual"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_unselected"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="VISUAL"
                                android:textColor="#A8B0B8"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tab_hud"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_unselected"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="HUD"
                                android:textColor="#A8B0B8"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tab_input"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_tab_unselected"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="INPUT"
                                android:textColor="#A8B0B8"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tab_misc"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_tab_unselected"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="MISC"
                                android:textColor="#A8B0B8"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Search -->
                    <EditText
                        android:id="@+id/search_input"
                        android:layout_width="140dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_search_glass"
                        android:hint="Search modules"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#F1F4F6"
                        android:textColorHint="#66A8B0B8"
                        android:textSize="12sp"
                        android:maxLines="1" />

                </LinearLayout>

                <!-- Mods list (two column style via GridLayoutManager) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/mods_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:id="@+id/empty_state_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="No mods in this category"
                        android:textColor="#66A8B0B8"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
